      "window-dark": {
        "$type": "shadow",
        "$value": "0 22px 80px rgb(0 0 0 / 38%)"
      },
      "window-hover": {
        "$type": "shadow",
        "$value": "0 26px 90px rgb(0 0 0 / 24%)"
      }
    }
