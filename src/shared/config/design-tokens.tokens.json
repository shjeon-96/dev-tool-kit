      "fast": { "$type": "duration", "$value": "{reference.motion.fast}" },
      "standard": {
        "$type": "duration",
        "$value": "{reference.motion.standard}"
      },
      "assemble": {
        "$type": "duration",
        "$value": "{reference.motion.assemble}"
      },
      "reduced": {
        "$type": "duration",
        "$value": "{reference.motion.reduced}"
      },
      "ease-standard": {
        "$type": "cubicBezier",
        "$value": "{reference.motion.ease-standard}"
