        "$value": "{reference.typography.size-display}"
      },
      "size-title": {
        "$type": "dimension",
        "$value": "{reference.typography.size-title}"
      },
      "weight-regular": {
        "$type": "fontWeight",
        "$value": "{reference.typography.weight-regular}"
      },
      "weight-semibold": {
        "$type": "fontWeight",
        "$value": "{reference.typography.weight-semibold}"
      },
      "weight-bold": {
        "$type": "fontWeight",
        "$value": "{reference.typography.weight-bold}"
      },
      "weight-black": {
        "$type": "fontWeight",
        "$value": "{reference.typography.weight-black}"
