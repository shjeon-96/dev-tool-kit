    "size": {
      "control": { "$type": "dimension", "$value": "44px" },
      "button": { "$type": "dimension", "$value": "56px" },
      "icon": { "$type": "dimension", "$value": "20px" },
      "content-width": { "$type": "dimension", "$value": "1440px" }
