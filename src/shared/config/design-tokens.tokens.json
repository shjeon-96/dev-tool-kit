    "typography": {
      "family-system": {
        "$type": "fontFamily",
        "$value": ["Arial", "Apple SD Gothic Neo", "Noto Sans KR", "sans-serif"]
      },
      "family-mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
